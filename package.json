{
  "name": "the-shape-of-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs .cloudflare/output/v0/workers/default/assets",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:visual": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run test:visual",
    "preview": "vite preview",
    "video:studio": "remotion studio video/index.ts",
    "video:typecheck": "tsc -p video/tsconfig.json --noEmit",
    "video:poster": "remotion still video/index.ts ShapeOfIntelligence renders/shape-of-intelligence-mobile-poster.png --frame=340",
    "video:handoff": "remotion still video/index.ts ShapeOfIntelligence renders/shape-of-intelligence-handoff.png --frame=1438",
    "video:render": "remotion render video/index.ts ShapeOfIntelligence renders/shape-of-intelligence-mobile.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --gop=60 --muted",
    "video:delivery": "remotion render video/index.ts ShapeOfIntelligenceDelivery renders/shape-of-intelligence-mobile-delivery.mp4 --codec=h264 --crf=26 --pixel-format=yuv420p --gop=60 --muted",
    "audio:check": "node --env-file=.env scripts/check-elevenlabs-env.mjs",
    "deploy": "npm run build && cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@remotion/cli": "^4.0.490",
    "@remotion/google-fonts": "^4.0.490",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "cf": "1.0.0-beta.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "remotion": "^4.0.490",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
